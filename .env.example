# Copie para .env (nunca commite o .env) e preencha os valores.

# Banco de dados: use DATABASE_URL (Postgres/MySQL na nuvem) OU as variáveis MYSQL_* abaixo
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
MYSQL_USER=astralys
MYSQL_PASSWORD=defina-uma-senha-forte
MYSQL_ROOT_PASSWORD=defina-outra-senha-forte
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=usuario

# Segurança JWT (SSO). OBRIGATÓRIO e com pelo menos 32 caracteres; o servidor não arranca sem isto.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Login Google do Ametist (opcional). Segredo JWT do projeto Supabase (Settings > API > JWT Secret).
# Sem isto, POST /auth/oauth-sync responde 503. Nunca exponha este valor no frontend.
# SUPABASE_JWT_SECRET=

# Origens extra permitidas no CORS, separadas por vírgula (opcional)
# ALLOWED_ORIGINS=https://meu-front.exemplo.com

# Porta do Servidor
PORT=8000
